# Telegram bot credentials (copy this file to .env and fill locally)
APP_ORIGIN=https://your-domain.example
TELEGRAM_BOT_TOKEN=
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MOOD_DATA_ENCRYPTION_KEY=
TELEGRAM_BOT_USERNAME=MoodBanquet_bot
TELEGRAM_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=

# First-call reminder and repeat-call reminder
TELEGRAM_FIRST_CALL_SLA_MINUTES=5
TELEGRAM_CALLBACK_REMINDER_MINUTES=30

# Optional allow-list of Telegram numeric user IDs, comma-separated
TELEGRAM_MANAGER_IDS=

# Do not set MOOD_TEST_MODE=true in production.
TRUST_PROXY=false
